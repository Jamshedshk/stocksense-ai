# StockSense AI Environment Configuration

# Database
# Local default: SQLite in backend directory
DATABASE_URL=sqlite:///./stocksense.db
# PostgreSQL example for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/stocksense_ai

# Environment
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="StockSense AI"

# CORS configuration (comma separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# SWI-Prolog binary path (auto-discovered if not specified)
SWIPL_PATH=C:\Program Files\swipl\bin\swipl.exe

# Timezone for business calculations
BUSINESS_TIMEZONE=UTC
